[
  {
    "origin": ["*"],
    "method": ["GET", "HEAD", "OPTIONS"],
    "responseHeader": [
      "Content-Type",
      "Content-Length",
      "Content-Range",
      "Content-Disposition",
      "Range",
      "Accept-Ranges",
      "x-goog-hash",
      "x-goog-generation",
      "x-goog-metageneration",
      "x-goog-stored-content-length"
    ],
    "maxAgeSeconds": 3600
  }
]
