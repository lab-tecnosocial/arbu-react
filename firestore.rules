rules_version = '2';

// Reglas de Firestore de Arbu (proyecto arbu-c574d).
//
// Este archivo se trajo desde la consola el 16/09/2026 (hasta entonces no
// estaba versionado) y desde ahí solo se le AÑADIÓ lo necesario para las
// campañas. Todo lo demás está tal cual estaba en producción: hay colecciones
// aquí que este repo no usa pero la app móvil sí (usuarios, scores, toques,
// reportes*, identificacionEspecies*, especiesCatalogo*), y borrarlas
// rompería la app.
//
// Desplegar con `pnpm deploy:rules` (NO va incluido en `pnpm deploy`).
service cloud.firestore {
  match /databases/{database}/documents {
    // match /{document=**} {
    //   allow read, write: if
    //       request.time < timestamp.date(2022, 1, 24);
    // }

    match /arbolesPlantados/{document=**} {
      allow read: if true;
      allow create: if request.auth.uid != null;
      allow update: if request.auth.uid != null;
    }
    match /arbolesMapeados/{document=**} {
      allow read: if true;
      allow create: if request.auth.uid != null;
      allow update: if request.auth.uid != null;
    }
    match /especiesCatalogo/{document=**} {
      allow read: if true;
    }
    match /especiesCatalogoActualizado/{document=**} {
      allow read: if true;
    }
    match /usuarios/{document=**} {
      allow read: if request.auth.uid != null;
    }
    match /usuarios_public/{document=**} {
      allow read: if true;
    }

   match /usuarios_public/{userId} {
     allow read: if true;
     allow create: if request.auth != null && request.auth.uid == userId;
     allow update: if request.auth != null && request.auth.uid == userId;
     allow delete: if request.auth != null && request.auth.uid == userId;
   }
    
    match /scores/{document=**} {
      allow read: if request.auth.uid != null;
    }
    match /scores/{userId} {
      allow read: if request.auth.uid != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }
    match /usuarios/{userId} {
      allow read: if request.auth.uid != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;  
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /reportesDeArboles/{document=**} {
      allow read: if request.auth.uid != null;
      allow create: if request.auth.uid != null;
    }
    match /reportesDeUsuarios/{document=**} {
      allow read: if request.auth.uid != null;
      allow create: if request.auth.uid != null;
    }
    match /ranking/{document=**} {
      // allow read: if request.auth.uid != null;
      allow read: if true;
    }
    match /toques/{document=**} {
      allow read: if request.auth.uid != null;
      allow create: if request.auth.uid != null;
      allow update: if request.auth.uid != null;
    }
  
    match /identificacionEspeciesCorrecta/{document=**} {
        // allow read: if request.auth.uid != null;
        allow read: if true;
        allow update: if request.auth != null;
        allow create: if request.auth != null;
    }
    match /identificacionEspeciesIncorrecta/{document=**} {
        // allow read: if request.auth.uid != null;
        allow read: if true;
        allow update: if request.auth != null;
        allow create: if request.auth != null;
    }

    match /equipo2025/{document=**} {
