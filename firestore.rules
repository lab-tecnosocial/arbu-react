 // Reglas para colección inscripcionesMapeo - solo lectura pública
      match /inscripcionesMapeo/{document=**} {
        allow read: if true;
         allow write: if request.auth.token.email in [
    "alex.r.ojeda@gmail.com",
    "agoriztribe@gmail.com",
    "erickxs78@gmail.com"
  ];
      }

      // Reglas para colección arbolesMapeados - solo lectura pública
      match /arbolesMapeados/{document=**} {
        allow read: if true;
        allow write: if false; // Solo lectura para prueba
      }
      
      // Permitir lectura del documento de usuarios autorizados
    match /usuariosAutorizados/accesoTablas {
      allow read: if request.auth != null;
      allow write: if false; // Solo administradores pueden modificar (usa Firebase Console)
    }

 // proyectos
 
      function isSuperAdmin() {
        return exists(/databases/$(database)/documents/usuariosAutorizados/accesoTablas) &&
               get(/databases/$(database)/documents/usuariosAutorizados/accesoTablas).data.roles[request.auth.token.email] == 'superadmin';
      }

      function isAuthorized() {
        return exists(/databases/$(database)/documents/usuariosAutorizados/accesoTablas) &&
               request.auth.token.email in
  get(/databases/$(database)/documents/usuariosAutorizados/accesoTablas).data.correos;
      }

      // "proyectos" es también la colección de CAMPAÑAS de mapeo: el nombre es
      // histórico, el concepto se generalizó sin migrar documentos.
      match /proyectos/{proyectoId} {
        // Las campañas marcadas como públicas se leen SIN sesión: de ahí sale
        // el selector de campañas del mapa público. El resto sigue como estaba.
        // Ojo: `allow list` se evalúa documento a documento y Firestore rechaza
        // la query entera si pudiera devolver uno no permitido, así que el
        // cliente consulta siempre con where("publica","==",true).
        allow read: if resource.data.publica == true || (
          request.auth != null && (
            isSuperAdmin() ||
            resource.data.usuarioAutorizado == request.auth.token.email
          )
        );

        allow create: if request.auth != null &&
          isAuthorized() &&
          request.resource.data.usuarioAutorizado == request.auth.token.email;

        allow update, delete: if request.auth != null && (
          isSuperAdmin() ||
          resource.data.usuarioAutorizado == request.auth.token.email
        );

        // Juicio humano del concurso. Nunca es público: solo el back-office.
        match /revisiones/{revisionId} {
          allow read: if request.auth != null && isAuthorized();
          allow write: if request.auth != null && isAuthorized() &&
            request.resource.data.revisadoPor == request.auth.token.email;
        }

        match /participantes/{uid} {
          allow read: if request.auth != null && isAuthorized();
          allow write: if request.auth != null && isAuthorized();
        }

        match /resultados/{resultadoId} {
          allow read: if request.auth != null && isAuthorized();
          allow write: if request.auth != null && isSuperAdmin();
        }
      }
      
      // otros
   match /inscripcionesMapeo/{userId} {
      allow create: if request.auth.uid != null;
    }

  match /inscripcionesMapeo/{userId} {
      allow create, update, delete: if request.auth != null && request.auth.uid == "LbKSpPtoKCMVh35rKb9yeq1iN5r1";
    }
  match /inscripcionesMapeo/{userId} {
      allow create, update, delete: if request.auth != null && request.auth.uid == "2BPwoK8H96WP8wyWvYdXhJ7T2p03";
    }



  }
